{
  "auth": {
    "required": true,
    "trustClientIdentityFields": false,
    "type": "session"
  },
  "contract": {
    "authority": ["R2_VIRTUAL_LAUNCH"],
    "governs": "TTTMP game session completion and play grant closure",
    "path": "/contracts/tttmp/tttmp.games.end.v1.json",
    "source": "Tax Tools Arcade",
    "title": "TTTMP — Games Contract — Game End",
    "usedOnPages": ["/games/*"],
    "validation": {
      "enumStrict": true,
      "normalizeCheckboxToBoolean": true,
      "rejectUnknownValues": true,
      "requireJsonContentType": true
    },
    "version": 1
  },
  "delivery": {
    "endpoint": "/v1/tttmp/games/end",
    "method": "POST",
    "receiptKeyPattern": "/receipts/tttmp/games/{event_id}.json",
    "receiptSource": "R2_VIRTUAL_LAUNCH",
    "signature": {
      "header": null,
      "required": false,
      "secretEnvVar": null
    }
  },
  "effects": {
    "dedupeKey": "{payload.grant_id}",
    "eventIdFrom": "EVT_{system.uuid}",
    "writeOrder": [
      "receiptAppend",
      "playGrantComplete"
    ],
    "writes": [
      "tttmp_play_grants"
    ]
  },
  "payload": {
    "additionalProperties": false,
    "properties": {
      "grant_id": {
        "type": "string",
        "minLength": 5
      },
      "score": {
        "type": "number",
        "minimum": 0
      },
      "completed": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["grant_id"],
    "type": "object"
  },
  "response": {
    "deduped": {
      "ok": true,
      "deduped": true,
      "grant_id": "{payload.grant_id}"
    },
    "error": {
      "ok": false,
      "error": "BAD_REQUEST|UNAUTHORIZED|NOT_FOUND|INTERNAL_ERROR"
    },
    "success": {
      "ok": true,
      "grant_id": "{payload.grant_id}"
    }
  },
  "schema": {
    "name": "tttmp_games_end",
    "version": 1
  }
}