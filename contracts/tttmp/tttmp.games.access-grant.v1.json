{
  "auth": {
    "required": true,
    "trustClientIdentityFields": false,
    "type": "session"
  },
  "contract": {
    "authority": ["R2_VIRTUAL_LAUNCH"],
    "governs": "TTTMP game access grant creation with token consumption",
    "path": "/contracts/tttmp/tttmp.games.access-grant.v1.json",
    "source": "Tax Tools Arcade",
    "title": "TTTMP — Games Contract — Access Grant",
    "usedOnPages": ["/games/*", "/app/games"],
    "validation": {
      "enumStrict": true,
      "normalizeCheckboxToBoolean": true,
      "rejectUnknownValues": true,
      "requireJsonContentType": true
    },
    "version": 1
  },
  "delivery": {
    "endpoint": "/v1/tttmp/games/access",
    "method": "POST",
    "receiptKeyPattern": "/receipts/tttmp/games/{event_id}.json",
    "receiptSource": "R2_VIRTUAL_LAUNCH",
    "signature": {
      "header": null,
      "required": false,
      "secretEnvVar": null
    }
  },
  "effects": {
    "dedupeKey": "{session.account_id}:{payload.game_slug}:{system.nowMinutes}",
    "eventIdFrom": "EVT_{system.uuid}",
    "writeOrder": [
      "receiptAppend",
      "tokenConsume",
      "playGrantCreate",
      "canonicalUpsert"
    ],
    "writes": [
      "tokens",
      "tttmp_play_grants"
    ]
  },
  "payload": {
    "additionalProperties": false,
    "properties": {
      "game_slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 50,
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "required": ["game_slug"],
    "type": "object"
  },
  "response": {
    "deduped": {
      "ok": true,
      "deduped": true,
      "grant_id": "{existing.grant_id}",
      "expires_at": "{existing.expires_at}",
      "balance_after": "{tokens.current_balance}"
    },
    "error": {
      "ok": false,
      "error": "BAD_REQUEST|UNAUTHORIZED|PAYMENT_REQUIRED|INTERNAL_ERROR",
      "message": "Insufficient tokens"
    },
    "success": {
      "ok": true,
      "grant_id": "{grant.grant_id}",
      "expires_at": "{grant.expires_at}",
      "balance_after": "{tokens.new_balance}"
    }
  },
  "schema": {
    "name": "tttmp_games_access_grant",
    "version": 1
  }
}